# Ghostfolio (fork « copilote ») : configuration homelab
#
# 1. ./init-secrets.sh copie ce fichier en .env et remplit les secrets vides
#    (ACCESS_TOKEN_SALT, JWT_SECRET_KEY, POSTGRES_PASSWORD, REDIS_PASSWORD,
#    VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY). Il n'écrase jamais une valeur.
# 2. Éditez .env : les lignes marquées « À RENSEIGNER » sont à adapter.
# 3. .env contient des secrets : ne le commitez pas (il est dans .gitignore).
#
# Ne mettez pas d'espace autour du « = » et évitez les guillemets, sauf pour
# les valeurs JSON (OIDC_SCOPE).

# ---------------------------------------------------------------------------
# Image et exposition (lues par docker compose, pas par Ghostfolio)
# ---------------------------------------------------------------------------

# Image du fork, construite par GitHub Actions. Épinglez un tag sha-xxxxxxx
# (visible sur la page du paquet GHCR) pour pouvoir revenir en arrière.
GHOSTFOLIO_IMAGE=ghcr.io/themlaw/ghostfolio:copilote

# Adresse et port publiés sur l'hôte pour le reverse proxy.
# 127.0.0.1 : proxy sur la même machine. Mettre l'IP du LAN (ou 0.0.0.0) si le
# proxy est ailleurs. Inutile avec Traefik (réseau Docker) ou Cloudflare Tunnel.
GHOSTFOLIO_BIND=127.0.0.1
GHOSTFOLIO_PORT=3333

# Variante Traefik (docker-compose.traefik.yml) : À RENSEIGNER si utilisée
GHOSTFOLIO_DOMAIN=ghostfolio.example.com
PROXY_NETWORK=proxy
TRAEFIK_CERTRESOLVER=letsencrypt

# Variante Cloudflare Tunnel (--profile cloudflare) : le jeton du tunnel va dans
# un fichier séparé, .env.cloudflare (voir .env.cloudflare.example), pour ne pas
# l'exposer au conteneur Ghostfolio.

# ---------------------------------------------------------------------------
# Base de données (PostgreSQL) et cache (Redis)
# ---------------------------------------------------------------------------

POSTGRES_DB=ghostfolio
POSTGRES_USER=ghostfolio
# Rempli par init-secrets.sh
POSTGRES_PASSWORD=
# Compose interpole ${...} dans ce fichier. Le mot de passe généré est
# hexadécimal : aucun caractère à échapper dans l'URL.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?connect_timeout=300

REDIS_HOST=redis
REDIS_PORT=6379
# Rempli par init-secrets.sh
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# URL publique de l'instance, en HTTPS, sans slash final. À RENSEIGNER.
# Elle sert à l'URL de callback OIDC, aux métadonnées OAuth de /.well-known/*
# et à l'hôte accepté par /mcp (HTTPS obligatoire pour le connecteur Claude).
ROOT_URL=https://ghostfolio.example.com

# Secrets, remplis par init-secrets.sh. Changer ACCESS_TOKEN_SALT invalide les
# jetons de sécurité existants ; changer JWT_SECRET_KEY déconnecte tout le monde.
ACCESS_TOKEN_SALT=
JWT_SECRET_KEY=

# Durée de vie de la session (JWT). 7 jours : bon compromis pour un téléphone,
# la reconnexion via Authentik est rapide. Défaut de Ghostfolio : 180 days.
JWT_EXPIRES_IN=7 days

# Nombre de reverse proxies devant Ghostfolio, pour lire la vraie IP du client
# (indispensable au rate limiting). 1 = un proxy (Caddy, Traefik seul,
# cloudflared). 2 = Cloudflare Tunnel + Traefik/Caddy devant l'appli.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Limitation de débit
# ---------------------------------------------------------------------------

ENABLE_FEATURE_RATE_LIMITING=true

# ---------------------------------------------------------------------------
# Connexion : OIDC (Authentik) uniquement
# ---------------------------------------------------------------------------

ENABLE_FEATURE_AUTH_OIDC=true
# Masque le bouton de connexion par jeton de sécurité dans l'interface.
# Si Authentik est indisponible, repassez à true pour entrer avec un jeton
# (uniquement possible pour un compte créé avec un jeton).
ENABLE_FEATURE_AUTH_TOKEN=false
# Connexion Google : désactivée (c'est aussi le défaut)
ENABLE_FEATURE_AUTH_GOOGLE=false

# Authentik : l'émetteur est de la forme https://<authentik>/application/o/<slug>/
# AVEC le slash final (c'est la valeur exacte de « issuer » dans
# <émetteur>/.well-known/openid-configuration). À RENSEIGNER.
OIDC_ISSUER=https://auth.example.com/application/o/ghostfolio/
# ID et secret du fournisseur OAuth2/OpenID créé dans Authentik. À RENSEIGNER.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optionnel : par défaut ROOT_URL/api/auth/oidc/callback, à enregistrer à
# l'identique dans Authentik (redirect URI en mode strict). Ne le définissez
# que si l'URL de callback diffère de ROOT_URL.
# OIDC_CALLBACK_URL=https://ghostfolio.example.com/api/auth/oidc/callback
# Tableau JSON. « openid » est toujours ajouté.
OIDC_SCOPE=["openid","profile","email"]

# Liste blanche : SEUL votre compte peut se connecter. Au moins une des deux
# lignes doit être renseignée en production (voir docs/deploy-homelab.md pour
# obtenir votre « sub »). Plusieurs valeurs : séparées par des virgules.
OIDC_ALLOWED_SUBJECTS=
# Alternative par e-mail (Authentik doit envoyer email_verified=true) :
OIDC_ALLOWED_EMAILS=
# Ancien comportement avec le JWT dans l'URL : à ne pas activer
OIDC_LEGACY_TOKEN_REDIRECT=false

# ---------------------------------------------------------------------------
# Veille et serveur MCP (claude.ai, Claude Code)
# ---------------------------------------------------------------------------

ENABLE_FEATURE_REPORTS=true
ENABLE_FEATURE_MCP=true
# Autorisation OAuth 2.1 pour les connecteurs personnalisés de claude.ai.
# Exige ROOT_URL en HTTPS.
ENABLE_FEATURE_MCP_OAUTH=true
# Refuse les anciens jetons MCP identifiés par l'id d'accès
MCP_ALLOW_LEGACY_TOKENS=false

# ---------------------------------------------------------------------------
# Notifications Web Push (PWA)
# ---------------------------------------------------------------------------

# Clés VAPID : remplies par init-secrets.sh. Ne les changez plus ensuite, sinon
# les abonnements existants des téléphones deviennent invalides.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact transmis aux services push : mailto:vous@exemple.fr ou une URL https.
# À RENSEIGNER (les notifications sont ignorées si ce champ est vide).
VAPID_SUBJECT=mailto:vous@example.com
