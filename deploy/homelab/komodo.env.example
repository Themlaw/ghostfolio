# Ghostfolio (fork « copilote ») : contenu du champ « Environment » de la stack
# Komodo (onglet Config de la stack, section Environment).
#
# 1. Générez les secrets : ./print-secrets.sh (affiche NOM=valeur, n'écrit rien).
# 2. Collez ce bloc dans Environment, remplacez les valeurs « À RENSEIGNER » et
#    les secrets, puis déployez. Komodo écrit ce texte dans un fichier
#    d'environnement à côté du compose (il le réécrit à chaque déploiement) :
#    c'est la seule source de vérité, il n'y a pas de .env à maintenir à la main.
# 3. Une variable obligatoire absente ou vide fait échouer le déploiement avec
#    un message explicite (voir docker-compose.yml).
#
# Format : NOM=valeur, sans espace autour du « = », sans guillemets (sauf JSON).
# Gardez une copie des secrets dans votre gestionnaire de mots de passe.

# ---------------------------------------------------------------------------
# À RENSEIGNER
# ---------------------------------------------------------------------------

# URL publique de l'instance, en HTTPS, sans slash final : elle doit être
# exactement le domaine de la ressource Pangolin. Elle sert à l'URL de callback
# OIDC, aux métadonnées OAuth, à l'hôte accepté par /mcp et au contrôle de
# l'hôte (ENABLE_FEATURE_HOST_VALIDATION).
ROOT_URL=https://ghostfolio.example.com

# Authentik : l'émetteur AVEC le slash final (valeur exacte de « issuer » dans
# <émetteur>/.well-known/openid-configuration).
OIDC_ISSUER=https://auth.example.com/application/o/ghostfolio/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Liste blanche : SEULS ces comptes peuvent se connecter (séparés par des
# virgules). Voir docs/deploy-homelab.md pour obtenir votre « sub ».
OIDC_ALLOWED_SUBJECTS=

# Contact transmis aux services push : mailto:vous@exemple.fr ou URL https.
VAPID_SUBJECT=mailto:vous@example.com

# ---------------------------------------------------------------------------
# Secrets (sortie de print-secrets.sh)
# ---------------------------------------------------------------------------
# Ne les régénérez plus ensuite : changer ACCESS_TOKEN_SALT invalide les jetons
# de sécurité, changer JWT_SECRET_KEY déconnecte tout le monde, changer les
# clés VAPID invalide les abonnements push des téléphones, changer
# POSTGRES_PASSWORD après le premier démarrage ne modifie PAS le mot de passe
# déjà enregistré dans la base.
ACCESS_TOKEN_SALT=
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Variante « Variables et Secrets globaux de Komodo » : créez chaque secret dans
# Settings > Variables (cochez « secret »), puis référencez-le avec [[NOM]]
# (Komodo remplace [[NOM]] avant d'écrire le fichier d'environnement). Exemple :
#   ACCESS_TOKEN_SALT=[[GHOSTFOLIO_ACCESS_TOKEN_SALT]]
#   JWT_SECRET_KEY=[[GHOSTFOLIO_JWT_SECRET_KEY]]
#   POSTGRES_PASSWORD=[[GHOSTFOLIO_POSTGRES_PASSWORD]]
#   REDIS_PASSWORD=[[GHOSTFOLIO_REDIS_PASSWORD]]
#   VAPID_PRIVATE_KEY=[[GHOSTFOLIO_VAPID_PRIVATE_KEY]]
#   VAPID_PUBLIC_KEY=[[GHOSTFOLIO_VAPID_PUBLIC_KEY]]
#   OIDC_CLIENT_SECRET=[[GHOSTFOLIO_OIDC_CLIENT_SECRET]]

# ---------------------------------------------------------------------------
# Réseau : Pangolin + Newt
# ---------------------------------------------------------------------------

# Ghostfolio reçoit le trafic depuis le conteneur Newt, sur un réseau Docker
# privé : le pair direct est une adresse privée (172.x, 10.x ou 192.168.x).
# « uniquelocal » fait confiance aux adresses privées (10/8, 172.16/12,
# 192.168/16, fc00::/7) comme proxys et lit alors l'IP du vrai client dans
# X-Forwarded-For (ajoutée par Pangolin). C'est sûr tant que Ghostfolio n'est
# joignable QUE par le réseau Docker (aucun port publié). Valeurs acceptées
# par Express « trust proxy » : un nombre de sauts (1), loopback, linklocal,
# uniquelocal, une adresse ou un CIDR, ou une liste séparée par des virgules.
# Si Pangolin est lui-même derrière Cloudflare, voir docs/deploy-homelab.md.
TRUST_PROXY=uniquelocal

# Refuse (421) toute requête dont l'en-tête Host n'est pas le domaine de
# ROOT_URL (ou de ALLOWED_HOSTS). localhost reste accepté pour la seule route de
# santé (healthcheck Docker).
ENABLE_FEATURE_HOST_VALIDATION=true
# Domaines supplémentaires acceptés, séparés par des virgules (rarement utile).
ALLOWED_HOSTS=

ENABLE_FEATURE_RATE_LIMITING=true

# ---------------------------------------------------------------------------
# Optionnel (valeurs par défaut du compose indiquées)
# ---------------------------------------------------------------------------

# Image du fork, construite par GitHub Actions. Épinglez un tag sha-xxxxxxx
# pour pouvoir revenir en arrière.
# GHOSTFOLIO_IMAGE=ghcr.io/themlaw/ghostfolio:copilote
# Nom du réseau Docker que Newt doit rejoindre
# GHOSTFOLIO_WEB_NETWORK=ghostfolio_web
# POSTGRES_DB=ghostfolio
# POSTGRES_USER=ghostfolio
# JWT_EXPIRES_IN=7 days
# ENABLE_FEATURE_AUTH_TOKEN=false
# ENABLE_FEATURE_MCP=true
# ENABLE_FEATURE_MCP_OAUTH=true
# ENABLE_FEATURE_REPORTS=true
# MCP_ALLOW_LEGACY_TOKENS=false
# OIDC_CALLBACK_URL=  (défaut : ROOT_URL/api/auth/oidc/callback)
# OIDC_ALLOWED_EMAILS=
