# Ghostfolio (fork « copilote ») : contenu COMPLET du champ « Environment » de
# la stack Komodo (onglet Config de la stack, section Environment).
#
# Toutes les variables lues par docker-compose.yml sont ici, aucune n'est
# commentée : collez le fichier tel quel, puis remplissez les valeurs vides.
#
# 1. Générez les secrets : ./print-secrets.sh (affiche NOM=valeur, n'écrit rien).
# 2. Remplissez les sections 1 (à renseigner) et 2 (secrets), puis déployez.
#    Komodo écrit ce texte dans un fichier d'environnement à côté du compose (il
#    le réécrit à chaque déploiement) : c'est la seule source de vérité.
# 3. Une variable obligatoire vide fait échouer le déploiement avec un message
#    explicite (voir docker-compose.yml).
#
# Format : NOM=valeur, sans espace autour du « = », sans guillemets (sauf JSON).
# Gardez une copie des secrets dans votre gestionnaire de mots de passe.

# ===========================================================================
# 1. À RENSEIGNER (obligatoire)
# ===========================================================================

# URL publique de l'instance, en HTTPS, sans slash final : exactement le
# domaine de la ressource Pangolin. Sert au callback OIDC, aux métadonnées
# OAuth, à l'hôte accepté par /mcp et au contrôle de l'hôte.
ROOT_URL=https://ghostfolio.example.com

# Authentik : l'émetteur AVEC le slash final (valeur exacte de « issuer » dans
# <émetteur>/.well-known/openid-configuration).
OIDC_ISSUER=https://auth.example.com/application/o/ghostfolio/
OIDC_CLIENT_ID=

# Liste blanche : SEULS ces comptes peuvent se connecter (séparés par des
# virgules). Voir docs/deploy-homelab.md pour obtenir votre « sub ».
# Si les deux sont vides, TOUT compte Authentik autorisé sur l'application
# peut se connecter : remplissez-en au moins une.
OIDC_ALLOWED_SUBJECTS=
OIDC_ALLOWED_EMAILS=

# Contact transmis aux services push : mailto:vous@exemple.fr ou URL https.
VAPID_SUBJECT=mailto:vous@example.com

# ===========================================================================
# 2. SECRETS (obligatoires)
# ===========================================================================
# Les six premiers : sortie de ./print-secrets.sh (openssl rand -hex 32 et
# paire VAPID). OIDC_CLIENT_SECRET : à copier depuis le fournisseur OAuth2
# d'Authentik (il n'est pas généré ici).
#
# Ne les régénérez plus ensuite : changer ACCESS_TOKEN_SALT invalide les jetons
# de sécurité, changer JWT_SECRET_KEY déconnecte tout le monde, changer les
# clés VAPID invalide les abonnements push des téléphones, changer
# POSTGRES_PASSWORD après le premier démarrage ne modifie PAS le mot de passe
# déjà enregistré dans la base.
#
# Variante « Variables globales de Komodo » : créez chaque secret dans
# Settings > Variables (cochez « secret ») et remplacez la valeur par sa
# référence, par ex. JWT_SECRET_KEY=[[GHOSTFOLIO_JWT_SECRET_KEY]].
ACCESS_TOKEN_SALT=
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
OIDC_CLIENT_SECRET=

# ===========================================================================
# 3. RÉSEAU : Pangolin + Newt (valeurs recommandées)
# ===========================================================================

# Ghostfolio reçoit le trafic du conteneur Newt sur un réseau Docker privé.
# « uniquelocal » fait confiance aux adresses privées (10/8, 172.16/12,
# 192.168/16, fc00::/7) et lit l'IP du vrai client dans X-Forwarded-For. Sûr
# tant que Ghostfolio n'est joignable QUE par le réseau Docker (aucun port
# publié). Si Pangolin est derrière Cloudflare, voir docs/deploy-homelab.md.
TRUST_PROXY=uniquelocal

# Refuse (421) toute requête dont l'en-tête Host n'est pas le domaine de
# ROOT_URL ou de ALLOWED_HOSTS. localhost reste accepté pour la seule route de
# santé (healthcheck Docker).
ENABLE_FEATURE_HOST_VALIDATION=true
# Domaines supplémentaires acceptés, séparés par des virgules (rarement utile).
ALLOWED_HOSTS=

ENABLE_FEATURE_RATE_LIMITING=true

# Nom du réseau Docker que Newt doit rejoindre.
GHOSTFOLIO_WEB_NETWORK=ghostfolio_web

# ===========================================================================
# 4. CONNEXION (valeurs recommandées)
# ===========================================================================

# OIDC (Authentik) est la seule méthode de connexion.
ENABLE_FEATURE_AUTH_OIDC=true
ENABLE_FEATURE_AUTH_GOOGLE=false
# Connexion par « jeton de sécurité » Ghostfolio : désactivée.
ENABLE_FEATURE_AUTH_TOKEN=false
# Ancien parcours qui renvoyait le jeton dans l'URL : désactivé.
OIDC_LEGACY_TOKEN_REDIRECT=false
# Vide = ROOT_URL/api/auth/oidc/callback (à déclarer tel quel dans Authentik).
OIDC_CALLBACK_URL=
# JSON : garder les guillemets doubles.
OIDC_SCOPE=["openid","profile","email"]
# Durée de la session web.
JWT_EXPIRES_IN=7 days

# ===========================================================================
# 5. COPILOTE : veilles, MCP, notifications (valeurs recommandées)
# ===========================================================================

ENABLE_FEATURE_REPORTS=true
ENABLE_FEATURE_MCP=true
# Connexion OAuth de claude.ai au MCP (enregistrement dynamique du client).
ENABLE_FEATURE_MCP_OAUTH=true
# Anciens jetons MCP non hachés : refusés.
MCP_ALLOW_LEGACY_TOKENS=false

# ===========================================================================
# 6. IMAGE ET BASE (valeurs par défaut)
# ===========================================================================

# Image du fork, construite par GitHub Actions. Épinglez un tag sha-xxxxxxx
# pour pouvoir revenir en arrière.
GHOSTFOLIO_IMAGE=ghcr.io/themlaw/ghostfolio:copilote
# À ne plus changer après le premier démarrage.
POSTGRES_DB=ghostfolio
POSTGRES_USER=ghostfolio
